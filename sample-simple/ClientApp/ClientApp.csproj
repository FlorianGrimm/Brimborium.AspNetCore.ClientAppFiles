<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <None Remove="node_modules/**/*" />
    <Compile Remove="node_modules/**/*" />
    <Content Remove="node_modules/**/*" />
  </ItemGroup>

  <Target Name="Restore">
    <Exec WorkingDirectory="$(MSBuildThisFileDirectory)" Command="npm install" />
    <Message Text="npm install" Importance="high"/>
  </Target>

  <Target Name="Build">
    <Exec WorkingDirectory="$(MSBuildThisFileDirectory)" Command="npm run build" Condition="'$(Configuration)' != 'Debug'" />
    <Exec WorkingDirectory="$(MSBuildThisFileDirectory)" Command="npm run build:dev" Condition="'$(Configuration)' == 'Debug'" />
  </Target>
</Project>
